<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/pie_shortcut_item_width"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/pie_shortcut_button_size"
        android:layout_height="@dimen/pie_shortcut_button_size"
        android:background="@drawable/pie_shortcut_button_background">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/contrast_button_text_spacing"
        android:gravity="center_horizontal|top"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
        android:textColor="@color/materialColorOnSurface" />
</LinearLayout>
