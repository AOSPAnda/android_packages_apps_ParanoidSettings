<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/settingslib_illustration_padding"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:importantForAccessibility="noHideDescendants">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="24dp"
        android:background="@drawable/color_contrast_preview_background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/pie_preview_top"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="15dp"
                android:background="@drawable/color_contrast_preview_icon_group_background"
                android:contentDescription="@null"
                android:tint="@color/pie_preview_slot_icon" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginVertical="12dp"
                android:padding="15dp"
                android:background="@drawable/color_contrast_preview_icon_group_background"
                android:backgroundTint="@color/pie_preview_active_background"
                android:contentDescription="@null"
                android:src="@drawable/ic_pie_back"
                android:tint="@color/pie_preview_active_icon" />

            <ImageView
                android:id="@+id/pie_preview_bottom"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="15dp"
                android:background="@drawable/color_contrast_preview_icon_group_background"
                android:contentDescription="@null"
                android:tint="@color/pie_preview_slot_icon" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
